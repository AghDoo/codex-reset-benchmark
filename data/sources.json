    {
      "id": "codexreset-org",
      "name": "Codex Reset Monitor",
      "url": "https://codexreset.org/",
      "forecast_url": "https://codexreset.org/",
      "enabled": true,
      "collector": {
        "type": "html_regex",
        "respect_robots": true,
        "max_response_bytes": 1500000,
        "probabilities": {
          "24h": {"pattern": "24\\s*hours.*?Final\\s*forecast:\\s*([0-9]+(?:\\.[0-9]+)?)%", "unit": "percent"},
          "48h": {"pattern": "48\\s*hours.*?Final\\s*forecast:\\s*([0-9]+(?:\\.[0-9]+)?)%", "unit": "percent"}
        }
      },
      "access": {
        "kind": "public_html",
        "authentication": "none",
        "notes": "Server-rendered forecast values are extracted from normalized visible text. The page grew slightly beyond the global 1 MB fetch cap, so this source alone has a 1.5 MB response limit; no smaller public forecast endpoint was found during the 2026-08-16 review."
      }
    },
    {
      "id": "codex-reset-radar",
      "name": "Codex Reset Radar",
      "url": "https://codexresetradar.com/",
      "forecast_url": "https://codexresetradar.com/",
      "enabled": true,
      "collector": {
        "type": "html_regex",
        "respect_robots": true,
        "probabilities": {
          "48h": {"pattern": "Next\\s*48\\s*(?:h|hours?)\\s*(?:reset\\s*chance\\s*)?([0-9]+(?:\\.[0-9]+)?)\\s*%", "unit": "percent"}
        }
      },
      "access": {
        "kind": "public_html",
        "authentication": "none",
        "notes": "The public page exposes a deterministic next-48h reset chance in visible text; whitespace before the percent sign is tolerated because SSR markup may split the token."
      }
    },
